# --- Database Configuration ---
DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/storedb

# --- Cache & Dedup Configuration ---
REDIS_URL=redis://redis:6379/0

# --- Server Host & Port ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Uptime & Security ---
LOG_LEVEL=INFO
VALID_API_KEYS=test_key_1,test_key_2
CORS_ORIGINS=http://localhost:5173

# --- Business Logic & Thresholds ---
STALE_FEED_THRESHOLD_MIN=10
REENTRY_WINDOW_MIN=60
REENTRY_SIMILARITY_THRESHOLD=0.85
QUEUE_SPIKE_THRESHOLD=5
CONVERSION_DROP_THRESHOLD_PCT=20
DEAD_ZONE_MIN=30

# --- AI & CV Models ---
YOLO_MODEL_PATH=./pipeline/models/yolov8x.pt
REID_MODEL_PATH=./pipeline/models/osnet_x1_0.pth
ANTHROPIC_API_KEY=your_optional_anthropic_api_key
